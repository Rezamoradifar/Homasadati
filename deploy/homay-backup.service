[Unit]
Description=Homay Saadat verified daily database and media backup
After=homay.service

[Service]
Type=oneshot
User=homay
Group=homay
WorkingDirectory=/opt/homay/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --import tsx /opt/homay/app/scripts/platform-backup.ts /opt/homay/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=1800
