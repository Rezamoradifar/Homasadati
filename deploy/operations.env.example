# Copy outside the repository to /etc/homay/operations.env, readable by root only.
# systemd loads this environment before changing to the homay user.
RESTIC_REPOSITORY_FILE=/etc/homay/restic-repository.private
RESTIC_PASSWORD_FILE=/etc/homay/restic-password.private
# Both referenced files must be readable by homay and mode 0600.
# For S3, add the provider's AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
# Initialize the chosen repository explicitly before enabling the timer.
ALERT_WEBHOOK_URL=
# Also put this same token in the web service's private environment.
MONITOR_TOKEN=
MONITOR_MIN_FREE_BYTES=536870912
HTTP_PORT=3000
