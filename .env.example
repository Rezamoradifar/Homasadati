# Node.js hosting with a persistent disk; never store this directory in public/.
DATABASE_PATH=./data/homay.sqlite
# Run npm run setup to generate a private .env.local, or set a unique password of 16+ characters.
ADMIN_PASSWORD=
# Set this to your exact HTTPS production origin. Leave empty for local development.
APP_ORIGIN=
# Only enable if your reverse proxy removes and sets X-Forwarded-For itself.
TRUST_PROXY=0
