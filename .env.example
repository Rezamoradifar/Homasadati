# Node.js hosting with a persistent disk; never store this directory in public/.
DATABASE_PATH=./data/homay.sqlite
# Run npm run setup to generate a private .env.local, or set a unique password of 16+ characters.
ADMIN_PASSWORD=
# Set this to your exact HTTPS production origin. Leave empty for local development.
APP_ORIGIN=
# Only enable if your reverse proxy removes and sets X-Forwarded-For itself.
TRUST_PROXY=0

# Generated once by npm run platform:setup. Back up securely with the database.
PLATFORM_MASTER_KEY=

# Optional custom tourism film and recorded Persian narration (rebuild after changing).
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_TOURISM_NARRATION_FA_URL=

# Cloudflare Turnstile: real keys scoped to the APP_ORIGIN hostname.
# Required BEFORE updating production. Missing keys block public authentication.
# Never use Cloudflare testing keys on production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bale wallet payments through the Homanets_bot bot (server-only).
# Keep disabled while preparing the bot and registering its webhook.
# Read docs/BALE-PAYMENTS.md; run platform:bale-setup after installing this code.
# BotFather supplies two different credentials: bot token and wallet provider token.
# Never use NEXT_PUBLIC_ prefixes, commit credentials, or put them in command arguments.
BALEPAY_ENABLED=0
BALEPAY_BOT_USERNAME=Homanets_bot
BALEPAY_BOT_TOKEN=
BALEPAY_PROVIDER_TOKEN=
# Generate 32 random bytes as 64 hex characters; store privately without printing.
# This authenticates a secret webhook path. Redact that path from proxy/APM logs.
BALEPAY_WEBHOOK_SECRET=
# APP_ORIGIN above must be the exact public HTTPS origin, e.g. https://homanets.com.
# Live checkout refuses WALLET-TEST-* provider tokens. No extra polling service is used.
