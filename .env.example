# Node.js hosting with a persistent disk; never store this directory in public/.
DATABASE_PATH=./data/homay.sqlite
# Run npm run setup to generate a private .env.local, or set a unique password of 16+ characters.
ADMIN_PASSWORD=
# Set this to your exact HTTPS production origin. Leave empty for local development.
APP_ORIGIN=
# Only enable if your reverse proxy removes and sets X-Forwarded-For itself.
TRUST_PROXY=0

# Generated once by npm run platform:setup. Back up securely with the database.
PLATFORM_MASTER_KEY=

# Optional custom tourism film and recorded Persian narration (rebuild after changing).
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_TOURISM_NARRATION_FA_URL=

# Cloudflare Turnstile: real keys scoped to the APP_ORIGIN hostname.
# Required BEFORE updating production. Missing keys block public authentication.
# Never use Cloudflare testing keys on production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# BalePay (پرداخت با بله). Server-only: never prefix these with NEXT_PUBLIC_.
# The option stays hidden until the official client in src/platform/bale-pay.ts
# is completed from the official BalePay documentation AND these are set.
# The callback URL is derived from APP_ORIGIN:
#   https://homanets.com/api/platform/payment/bale/callback
# TODO: BALEPAY OFFICIAL VALUE REQUIRED — confirm each name/value below.
BALEPAY_API_BASE_URL=
BALEPAY_TOKEN=
BALEPAY_MERCHANT_ID=
# Comma-separated host names of the Bale payment page the customer may be sent to.
BALEPAY_REDIRECT_HOSTS=

# DigiPay UPG credit / instalment-wallet purchases. Server-only secrets.
# Enable only after DigiPay activates CPG/BPG for this merchant and domain.
# Sandbox is deliberately refused in a NODE_ENV=production process.
DIGIPAY_ENABLED=0
DIGIPAY_ENVIRONMENT=sandbox
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
# Optional merchant-specific overrides. Empty values use the official
# single-store plugin defaults: sellerId=1 and supplierId=1.
DIGIPAY_SELLER_ID=
DIGIPAY_SUPPLIER_ID=
# Optional truthful brand fallback. A missing brand is sent as an empty string,
# matching DigiPay's official plugin; never invent a product brand.
DIGIPAY_DEFAULT_BRAND=
# Optional catalogue-category overrides with productType 1-4.
# Empty/{} uses Homa's existing catalogue roots and their product types.
# Shape: {"craft":{"categoryId":"<approved-id>","productType":1}}
# These are catalogue identifiers, not API authentication credentials.
DIGIPAY_CATEGORY_MAP_JSON={}
# Callback is derived from APP_ORIGIN:
# https://homanets.com/api/platform/payment/digipay/callback
